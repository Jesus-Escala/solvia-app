# Base URL of the Solvia API. Keep "/api" to use the Vite dev proxy (and nginx in Docker).
VITE_API_URL=/api
# Where the Vite dev server proxies /api and /files requests
VITE_PROXY_TARGET=http://localhost:4000
# ISO 4217 currency used to format amounts
VITE_CURRENCY=PEN
# Public landing page ("request access" link on the sign-in page)
VITE_LANDING_URL=http://localhost:5174
